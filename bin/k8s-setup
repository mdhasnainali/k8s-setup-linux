#!/bin/bash
set -e

# k8s-setup - CLI for bootstrapping/tearing down kubeadm Kubernetes nodes
# on Ubuntu/Debian. Thin dispatcher over scripts/*.sh.

VERSION="1.0.0"

# Resolve real path to this file (follow symlinks, e.g. when installed at
# /usr/local/bin/k8s-setup -> .../bin/k8s-setup) so SCRIPTS_DIR is correct
# regardless of how the CLI was invoked.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd -P "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"
SCRIPTS_DIR="$ROOT_DIR/scripts"

usage() {
    cat <<EOF
k8s-setup $VERSION - bootstrap/tear down kubeadm Kubernetes nodes (Ubuntu/Debian)

Usage:
  k8s-setup controller install <endpoint> [version]   Provision this node as control-plane
  k8s-setup controller uninstall                       Tear down a control-plane node
  k8s-setup controller join-command                    Print a kubeadm join command for workers

  k8s-setup worker install [version]                   Prep this node as a worker
  k8s-setup worker uninstall                            Tear down a worker node

  k8s-setup version                                     Print CLI version
  k8s-setup help                                        Show this help

Docs: $ROOT_DIR/docs
EOF
}

case "$1" in
    controller)
        case "$2" in
            install)   shift 2; exec "$SCRIPTS_DIR/controller-install.sh" "$@" ;;
            uninstall) shift 2; exec "$SCRIPTS_DIR/controller-uninstall.sh" "$@" ;;
            join-command) shift 2; exec "$SCRIPTS_DIR/controller-join-command.sh" "$@" ;;
            *) echo "Error: unknown controller subcommand '$2'" >&2; usage; exit 1 ;;
        esac
        ;;
    worker)
        case "$2" in
            install)   shift 2; exec "$SCRIPTS_DIR/worker-install.sh" "$@" ;;
            uninstall) shift 2; exec "$SCRIPTS_DIR/worker-uninstall.sh" "$@" ;;
            *) echo "Error: unknown worker subcommand '$2'" >&2; usage; exit 1 ;;
        esac
        ;;
    version|-v|--version)
        echo "k8s-setup $VERSION"
        ;;
    help|-h|--help|"")
        usage
        ;;
    *)
        echo "Error: unknown command '$1'" >&2
        usage
        exit 1
        ;;
esac
